<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 联网（标签/歌词/封面/更新检查）。必须放在 main 清单：Flutter 模板只把它放进
         debug/profile 清单，release 版会因此完全没网。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 读取音频只在用户点「从系统媒体库导入」时才申请（不选目录不需要任何权限） -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- 长任务（批量匹配 / 写入 / 补封面）挂前台服务，退后台才不会被系统回收 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- 试听播放的前台服务（通知栏媒体控制卡） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- 任务期间持唤醒锁：息屏后 CPU 继续跑，批量匹配不再「解锁后又接着跑」 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 安卓 13+ 要显式申请才能显示任务通知 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 应用内更新：下载完 APK 后拉起系统安装器。用户首次会看到「允许从此来源安装」
         的系统确认；不申请存储权限，APK 走 FileProvider 临时授权。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <application
        android:label="音乐整理"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- 外部调起：在文件管理器里「用本应用编辑 / 打开」音频文件 -->
            <intent-filter>
                <action android:name="android.intent.action.EDIT"/>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="audio/*"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.EDIT"/>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:scheme="content"/>
                <data android:mimeType="audio/*"/>
            </intent-filter>
        </activity>
        <service
            android:name=".TaskForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- 试听播放的通知栏媒体控制（MediaSession） -->
        <service
            android:name=".PlaybackNotificationService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <receiver
            android:name=".PlaybackControlReceiver"
            android:exported="false" />
        <!-- 应用内更新：把 cache/updates/ 里下载好的 APK 临时授权给系统安装器。
             Android 8+ 不允许直接传 file:// 路径，必须走 FileProvider。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
